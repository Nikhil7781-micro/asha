// =====================================================
// ASHA RESCUE ROVER
// PHASE 2 - BTS7960 + ONE MOTOR
// =====================================================

#define RPWM 25
#define LPWM 26

#define R_EN 27
#define L_EN 14

void motorStop();
void motorForward(int speed);
void motorReverse(int speed);

void setup() {

  Serial.begin(115200);

  pinMode(RPWM, OUTPUT);
  pinMode(LPWM, OUTPUT);

  pinMode(R_EN, OUTPUT);
  pinMode(L_EN, OUTPUT);

  // Enable both sides of BTS7960
  digitalWrite(R_EN, HIGH);
  digitalWrite(L_EN, HIGH);

  // Start stopped
  motorStop();

  Serial.println();
  Serial.println("================================");
  Serial.println("       ASHA RESCUE ROVER");
  Serial.println("       PHASE 2 - MOTOR");
  Serial.println("================================");

  Serial.println("Motor driver initialized");
}


// Forward
void motorForward(int speed) {

  speed = constrain(speed, 0, 255);

  analogWrite(RPWM, speed);
  analogWrite(LPWM, 0);

  Serial.print("FORWARD - PWM: ");
  Serial.println(speed);
}


// Reverse
void motorReverse(int speed) {

  speed = constrain(speed, 0, 255);

  analogWrite(RPWM, 0);
  analogWrite(LPWM, speed);

  Serial.print("REVERSE - PWM: ");
  Serial.println(speed);
}


// Stop
void motorStop() {

  analogWrite(RPWM, 0);
  analogWrite(LPWM, 0);

  Serial.println("MOTOR STOP");
}


void loop() {

  // -----------------------------
  // Forward at low speed
  // -----------------------------

  motorForward(80);
  delay(3000);

  motorStop();
  delay(2000);


  // -----------------------------
  // Forward at medium speed
  // -----------------------------

  motorForward(130);
  delay(3000);

  motorStop();
  delay(2000);


  // -----------------------------
  // Reverse at low speed
  // -----------------------------

  motorReverse(80);
  delay(3000);

  motorStop();
  delay(3000);
}
